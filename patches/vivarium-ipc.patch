+ * Calculate a signature from workspace names and window counts.
+ * Detects occupancy changes without writing on every rendered frame.
+ */
+static uint64_t workspace_occupancy_signature(struct wl_list *workspaces) {
+    uint64_t hash = 14695981039346656037ULL;
+
+    struct viv_workspace *workspace;
+
+    wl_list_for_each(workspace, workspaces, server_link) {
+        const unsigned char *p = (const unsigned char *)workspace->name;
+
+        while (*p) {
+            hash ^= *p++;
+            hash *= 1099511628211ULL;
+        }
+
+        uint64_t count = (uint64_t)wl_list_length(&workspace->views);
+
+        for (int i = 0; i < 8; i++) {
+            hash ^= (count >> (i * 8)) & 0xFF;
+            hash *= 1099511628211ULL;
+        }
+    }
+
+    return hash;
+}
