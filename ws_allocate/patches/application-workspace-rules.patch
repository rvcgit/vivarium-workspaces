+void viv_server_apply_window_rule(struct viv_view *view) {
+    if (!view || !view->server || !view->server->config) {
+        return;
+    }
+
+    struct viv_config *config = view->server->config;
+
+    if (!config->window_rules || config->window_rule_count == 0) {
+        return;
+    }
+
+    const char *app_id = viv_view_get_app_id(view);
+    if (!app_id || app_id[0] == '\0') {
+        return;
+    }
+
+    for (size_t i = 0; i < config->window_rule_count; i++) {
+        struct viv_window_rule *rule = &config->window_rules[i];
+
+        if (!rule->app_id || strcmp(rule->app_id, app_id) != 0) {
+            continue;
+        }
+
+        if (rule->workspace_number < 1 ||
+            rule->workspace_number > MAX_NUM_WORKSPACES) {
+            wlr_log(WLR_ERROR,
+                "Window rule for \"%s\" has an invalid workspace number",
+                app_id);
+            return;
+        }
+
+        char *workspace_name =
+            config->workspaces[rule->workspace_number - 1];
+
+        struct viv_workspace *workspace =
+            viv_server_retrieve_workspace_by_name(view->server, workspace_name);
+
+        if (!workspace) {
+            wlr_log(WLR_ERROR,
+                "Window rule: workspace %u for application \"%s\" was not found",
+                rule->workspace_number, app_id);
+            return;
+        }
+
+        view->workspace = workspace;
+
+        wlr_log(WLR_INFO,
+            "Window rule: placing application \"%s\" on workspace %u",
+            app_id, rule->workspace_number);
+
+        return;
+    }
+}
