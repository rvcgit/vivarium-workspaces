+static char *get_active_config_path(char *user_path) {
+    if (user_path) {
+        return strdup(user_path);
+    }
+
+    return get_default_config_path();
+}
+
+static char *get_window_rules_path(const char *config_path) {
+    if (!config_path) {
+        return NULL;
+    }
+
+
+    const char *last_slash = strrchr(config_path, '/');
+
+    if (!last_slash) {
+        return strdup("window_rules.conf");
+    }
+
+    size_t directory_length = last_slash - config_path + 1;
+    const char filename[] = "window_rules.conf";
+
+    char *rules_path = malloc(directory_length + sizeof(filename));
+
+    if (!rules_path) {
+        return NULL;
+    }
+
+    memcpy(rules_path, config_path, directory_length);
+    memcpy(rules_path + directory_length, filename, sizeof(filename));
+
+    return rules_path;
+}
+
+static char *trim_whitespace(char *text) {
+    while (isspace((unsigned char)*text)) {
+        text++;
+    }
+
+    if (*text == '\0') {
+        return text;
+    }
+
+    char *end = text + strlen(text) - 1;
+
+    while (end > text && isspace((unsigned char)*end)) {
+        end--;
+    }
+
+    end[1] = '\0';
+
+    return text;
+}
+
+static void clear_window_rules(struct viv_config *config) {
+    for (size_t i = 0; i < config->window_rule_count; i++) {
+        free(config->window_rules[i].app_id);
+    }
+
+    free(config->window_rules);
+    config->window_rules = NULL;
+    config->window_rule_count = 0;
+}
+
+static void load_window_rules(struct viv_config *config, char *user_path) {
+    char *config_path = get_active_config_path(user_path);
+
+    if (!config_path) {
+        wlr_log(WLR_ERROR, "Could not determine config path for window rules");
+        return;
+    }
+
+    char *rules_path = get_window_rules_path(config_path);
+    free(config_path);
+
+    if (!rules_path) {
+        wlr_log(WLR_ERROR, "Could not allocate window rules path");
+        return;
+    }
+
+    FILE *file = fopen(rules_path, "r");
+
+    if (!file) {
+        wlr_log(WLR_DEBUG, "No window rules file found at \"%s\"", rules_path);
+        clear_window_rules(config);
+        free(rules_path);
+        return;
+    }
+
+    struct viv_window_rule *new_rules = NULL;
+    size_t new_rule_count = 0;
+
+    char *line = NULL;
+    size_t line_capacity = 0;
+    size_t line_number = 0;
+    bool allocation_failed = false;
+
+    while (getline(&line, &line_capacity, file) != -1) {
+        line_number++;
+
+        char *text = trim_whitespace(line);
+
+        if (*text == '\0' || *text == '#') {
+            continue;
+        }
+
+        char *separator = strchr(text, '=');
+
+        if (!separator || strchr(separator + 1, '=')) {
+            wlr_log(WLR_ERROR,
+                "Window rules: invalid syntax on line %zu",
+                line_number);
+            continue;
+        }
+
+        *separator = '\0';
+
+        char *app_id = trim_whitespace(text);
+        char *workspace_text = trim_whitespace(separator + 1);
+
+        if (*app_id == '\0' || *workspace_text == '\0') {
+            wlr_log(WLR_ERROR,
+                "Window rules: empty application or workspace on line %zu",
+                line_number);
+            continue;
+        }
+
+        char *number_end;
+        long workspace_number = strtol(workspace_text, &number_end, 10);
+
+        if (number_end == workspace_text || *number_end != '\0' ||
+            workspace_number < 1 ||
+            workspace_number > MAX_NUM_WORKSPACES) {
+            wlr_log(WLR_ERROR,
+                "Window rules: invalid workspace number on line %zu",
+                line_number);
+            continue;
+        }
+
+        if (config->workspaces[workspace_number - 1][0] == '\0') {
+            wlr_log(WLR_ERROR,
+                "Window rules: workspace %ld is not configured (line %zu)",
+                workspace_number, line_number);
+            continue;
+        }
+
+        char *app_id_copy = strdup(app_id);
+
+        if (!app_id_copy) {
+            allocation_failed = true;
+            break;
+        }
+
+        struct viv_window_rule *resized_rules = realloc(
+            new_rules,
+            (new_rule_count + 1) * sizeof(*new_rules)
+        );
+
+        if (!resized_rules) {
+            free(app_id_copy);
+            allocation_failed = true;
+            break;
+        }
+
+        new_rules = resized_rules;
+
+        new_rules[new_rule_count].app_id = app_id_copy;
+        new_rules[new_rule_count].workspace_number = workspace_number;
+
+        new_rule_count++;
+    }
+
+    if (ferror(file)) {
+        wlr_log(WLR_ERROR, "Error reading window rules file");
+        allocation_failed = true;
+    }
+
+    free(line);
+
+    if (fclose(file) != 0) {
+        wlr_log(WLR_ERROR, "Error closing window rules file");
+        allocation_failed = true;
+    }
+
+    free(rules_path);
+
+    if (allocation_failed) {
+        for (size_t i = 0; i < new_rule_count; i++) {
+            free(new_rules[i].app_id);
+        }
+
+        free(new_rules);
+
+        wlr_log(WLR_ERROR, "Could not load window rules; keeping previous rules");
+        return;
+    }
+
+    clear_window_rules(config);
+
+    config->window_rules = new_rules;
+    config->window_rule_count = new_rule_count;
+
+    wlr_log(WLR_INFO, "Loaded %zu application window rules", new_rule_count);
+}
